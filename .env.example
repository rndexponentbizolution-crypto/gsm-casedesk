NODE_ENV=development
APP_PORT=3001
WEB_PORT=3000
# The API, Prisma and the web app all read this root .env file.
# Docker Compose publishes PostgreSQL on host port 5433 (POSTGRES_HOST_PORT) so it never
# collides with a locally installed PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://casedesk:casedesk@localhost:5433/casedesk
REDIS_URL=redis://localhost:6379
# Sign-in. AUTH_MODE=keycloak (default) requires a Keycloak access token on every API call.
# AUTH_MODE=demo trusts an x-demo-user header for local work without Keycloak; the API
# refuses to start with it when NODE_ENV=production. Set NEXT_PUBLIC_AUTH_MODE to match.
AUTH_MODE=keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=gsm-casedesk
# Audience the API requires in access tokens (added by the web client's audience mapper).
KEYCLOAK_AUDIENCE=gsm-casedesk-api
# Only needed when the API reaches Keycloak on a different URL than browsers do (e.g. Docker).
# KEYCLOAK_ISSUER=http://localhost:8080/realms/gsm-casedesk
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_MODE=keycloak
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=gsm-casedesk
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=gsm-casedesk-web
SESSION_SECRET=replace-with-a-long-random-value
META_APP_SECRET=
META_VERIFY_TOKEN=development-verify-token
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_GRAPH_VERSION=v22.0
# WhatsApp. SIMULATION_ENABLED=true keeps everything inside CaseDesk (simulator on).
# false = live: the signed Meta webhook (/webhooks/whatsapp) is the only way in, the
# outbox delivers through the Graph API, and META_* plus S3_BUCKET become required.
SIMULATION_ENABLED=true

# Attachment storage (any S3-compatible service; MinIO from docker compose locally).
# Leave S3_BUCKET empty in simulation to keep attachments in memory instead.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=casedesk-attachments
S3_ACCESS_KEY=casedesk
S3_SECRET_KEY=change-me
# Path-style URLs (needed for MinIO). Set false for AWS virtual-hosted style.
S3_FORCE_PATH_STYLE=true

# Virus scanning with ClamAV (docker compose --profile scan up -d clamav).
# Unset = attachments are stored as NOT_SCANNED.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# Requests per minute per client IP (Meta webhook and /health are exempt).
RATE_LIMIT_PER_MINUTE=300
# Proxy hops in front of the API, for the real client IP. Defaults to 1 in production.
# TRUST_PROXY=1
