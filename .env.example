NODE_ENV=development
APP_PORT=3001
WEB_PORT=3000
# The API, Prisma, the tests and the web app all read this root .env file.
#
# Secrets below are blank on purpose. Fill them all at once with:
#   node infrastructure/generate-secrets.mjs
# Docker Compose refuses to start while any of them is empty.

# ---------- Database ----------
# Docker Compose publishes PostgreSQL on host port 5433 (POSTGRES_HOST_PORT) so it never
# collides with a locally installed PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433
POSTGRES_PASSWORD=
# Written by generate-secrets.mjs from POSTGRES_PASSWORD.
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# ---------- Sign-in (Keycloak) ----------
# Every API call needs a Keycloak access token; there is no other way in.
# Host port for the Compose Keycloak (change it, and the two URLs, if 8080 is taken).
KEYCLOAK_HOST_PORT=8080
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=gsm-casedesk
# Audience the API requires in access tokens (added by the web client's audience mapper).
KEYCLOAK_AUDIENCE=gsm-casedesk-api
# Only needed when the API reaches Keycloak on a different URL than browsers do (e.g. Docker).
# KEYCLOAK_ISSUER=http://localhost:8080/realms/gsm-casedesk
# CaseDesk's account-management client: lets administrators create staff sign-ins.
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Keycloak's own database login and admin-console password (Compose only).
KEYCLOAK_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=keycloak-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# ---------- Web app (compiled into the browser bundle) ----------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=gsm-casedesk
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=gsm-casedesk-web

# ---------- WhatsApp ----------
# SIMULATION_ENABLED=true: replies are recorded but never sent, and nothing comes in.
# false = live: the signed Meta webhook (/webhooks/whatsapp) is the only way in, the
# outbox delivers through the Graph API, and META_* plus S3_BUCKET become required.
SIMULATION_ENABLED=true
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_GRAPH_VERSION=v22.0

# ---------- Attachments ----------
# Any S3-compatible service; MinIO from docker compose locally (its password is
# S3_SECRET_KEY). Leave S3_BUCKET empty to keep attachments in memory instead.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=casedesk-attachments
S3_ACCESS_KEY=casedesk
S3_SECRET_KEY=
# Path-style URLs (needed for MinIO). Set false for AWS virtual-hosted style.
S3_FORCE_PATH_STYLE=true

# Virus scanning with ClamAV (docker compose --profile scan up -d clamav).
# Unset = attachments are stored as NOT_SCANNED.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# ---------- Hardening ----------
# Requests per minute per client IP (Meta webhook and /health are exempt).
RATE_LIMIT_PER_MINUTE=300
# Proxy hops in front of the API, for the real client IP. Defaults to 1 in production.
# TRUST_PROXY=1
